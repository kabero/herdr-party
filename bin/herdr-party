#!/usr/bin/env bash
# herdr-party: パーティー会場のペインを現在のタブの右側に開く／閉じる。
#
# 使い方:
#   herdr-party [--toggle|--open|--close] [--width 0.3] [--focus] [-- <herdr-party-agents の引数...>]
#     --toggle  既定。開いていれば閉じ、閉じていれば開く
#     --open    開く（すでに開いていれば何もしない）
#     --close   閉じる
#     --width   右ペインの幅の割合（デフォルト 0.3）
#     --focus   開いたペインにフォーカスを移す
set -eu

HERDR="${HERDR_BIN_PATH:-herdr}"

if [ "${HERDR_ENV:-}" != 1 ]; then
  echo "herdr-party: Herdr のペイン内で実行してください (HERDR_ENV=1 が必要)" >&2
  exit 1
fi

MODE=toggle
WIDTH=0.3
FOCUS="--no-focus"
VIEWER_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --toggle|--open|--close) MODE="${1#--}" ;;
    --width) shift; WIDTH="$1" ;;
    --focus) FOCUS="--focus" ;;
    --) shift; VIEWER_ARGS=("$@"); break ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VIEWER="$SCRIPT_DIR/herdr-party-agents"

# プラグインアクション経由などで呼び出し元の場所が無いときは、フォーカス中の space / タブを使う
if [ -z "${HERDR_WORKSPACE_ID:-}" ] || [ -z "${HERDR_TAB_ID:-}" ]; then
  cur="$("$HERDR" pane current 2>/dev/null || true)"
  HERDR_WORKSPACE_ID="${HERDR_WORKSPACE_ID:-$(printf '%s' "$cur" | jq -r '.result.pane.workspace_id // empty')}"
  HERDR_TAB_ID="${HERDR_TAB_ID:-$(printf '%s' "$cur" | jq -r '.result.pane.tab_id // empty')}"
fi

# どの space にいても、ビューアを前面で動かしているペインを探す（追従で別タブへ行っていることがある）
find_party_panes() {
  "$HERDR" workspace list | jq -r '.result.workspaces[].workspace_id' | while read -r ws; do
    "$HERDR" pane list --workspace "$ws" | jq -r '.result.panes[].pane_id'
  done \
    | while read -r pid; do
        if "$HERDR" pane process-info --pane "$pid" 2>/dev/null \
           | jq -e '.result.process_info.foreground_processes[]?.argv[]? | select(endswith("herdr-party-agents"))' >/dev/null; then
          echo "$pid"
        fi
      done
}

existing="$(find_party_panes)"

if [ "$MODE" = toggle ]; then
  if [ -n "$existing" ]; then MODE=close; else MODE=open; fi
fi

case "$MODE" in
  close)
    for pid in $existing; do "$HERDR" pane close "$pid" >/dev/null; done
    ;;
  open)
    if [ -n "$existing" ]; then
      echo "$existing"
      exit 0
    fi
    # 右に分割。herdr の --ratio は元ペイン側の割合なので 1 - width を渡す。
    RATIO="$(awk -v w="$WIDTH" 'BEGIN { printf "%.3f", 1 - w }')"
    # 呼び出し元のペインが分かればそれを、なければ UI でフォーカス中のペインを分割する
    if [ -n "${HERDR_PANE_ID:-}" ]; then target=(--current); else target=(); fi
    split_json="$("$HERDR" pane split "${target[@]+"${target[@]}"}" --direction right --ratio "$RATIO" --cwd "$PWD" "$FOCUS")"
    pane_id="$(printf '%s' "$split_json" | jq -r '.result.pane.pane_id')"
    [ -n "$pane_id" ] && [ "$pane_id" != "null" ] || { echo "herdr-party: ペイン分割に失敗: $split_json" >&2; exit 1; }
    "$HERDR" pane rename "$pane_id" "party" >/dev/null
    cmd="$(printf '%q ' "$VIEWER" --width "$WIDTH" "${VIEWER_ARGS[@]+"${VIEWER_ARGS[@]}"}")"
    "$HERDR" pane run "$pane_id" "exec $cmd" >/dev/null
    echo "$pane_id"
    ;;
esac
