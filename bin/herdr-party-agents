#!/usr/bin/env python3
"""herdr-party-agents: Herdr のセッションを棒人間、space をパーティー会場のステージとして描画する。

使い方:
  herdr-party-agents [--all] [--interval SEC] [--list] [--report] [--report-only [--once]]
    --all           claude 以外のエージェントも招待する
    --interval SEC  エージェント情報の更新間隔（秒、デフォルト 2）
    --list          棒人間ではなく一覧表示にする
    --report        描画しつつ、各セッションのペインに名前とポーズをメタデータとして報告する
                    （Herdr のサイドバーで $party_name / $party_pose として表示できる）
    --report-only   画面を出さずに報告だけを続ける。--once で 1 回だけ報告して終了
    --follow        タブや space を移動したら会場のペインも移動先の右側へ引っ越す（既定）
    --no-follow     引っ越さない
    --width RATIO   引っ越すときの会場の幅の割合（デフォルト 0.3）
    --lobby-after MIN  この分数以上 idle の人はステージの下のロビーに集める（デフォルト 30、0 で無効）

操作:
  マウス      棒人間に乗せるとタイトル、クリックでそのセッションを開く
  ← → h l    guest を選ぶ（↑ ↓ j k も同じ）
  Tab        要注意（承認待ち・完了）の guest へジャンプ
  Enter / o  選んだ guest のセッションを開く
  Esc        選択を解除
  ?          操作の説明を出す / 消す
  q          終了

環境変数 HERDR_PARTY_LOG にファイルパスを入れると、クリックとフォーカスの経過を記録する。
"""
import datetime
import glob
import hashlib
import json
import os
import re
import select
import shutil
import socket
import subprocess
import sys
import threading
import time
import unicodedata

ESC = "\033"
RESET = ESC + "[0m"
BOLD = ESC + "[1m"
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")
MOUSE_RE = re.compile(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
KEY_RE = re.compile(rb"\x1b\[([ABCD])|\x1b|[\x00-\x7f]", re.S)
MOUSE_ON = ESC + "[?1003h" + ESC + "[?1006h"
MOUSE_OFF = ESC + "[?1003l" + ESC + "[?1006l"


def fg(n):
    return f"{ESC}[38;5;{n}m"


# パレット（256 色）
PINK, CYAN, LAVENDER, MINT, PEACH, LEMON, RED = 213, 117, 141, 121, 216, 228, 210
SAGE = 108  # idle 用の控えめな緑
GRAY, SOFT = 245, 240
NAME = 253  # 棒人間の名前（GRAY だと薄すぎる）
STATUS_COLOR = {
    "working": fg(LEMON),
    "blocked": fg(RED),
    "done": fg(CYAN),
    "idle": fg(SAGE),
    "unknown": fg(GRAY),
}
STATUS_WORD = {"working": "dancing", "blocked": "waiting", "done": "done", "idle": "chilling", "unknown": "?"}
ICON = {"working": "◐", "blocked": "◆", "done": "✔", "idle": "●", "unknown": "?"}
TABLE_PALETTE = [PINK, CYAN, LAVENDER, MINT, PEACH, LEMON]
RAINBOW = [203, 209, 215, 221, 227, 155, 120, 86, 81, 75, 105, 141, 177, 213]  # 稼働中の棒人間を流れる虹色
ATTENTION = ("blocked", "done")  # 要注意として上部に並べる状態
TIMED_STATES = ("blocked", "done", "working")  # 名前の下に経過時間を出す状態
GUEST_ROWS = 5  # 名前、時間、棒人間 3 行
LOBBY_AFTER = 30 * 60  # 秒。これ以上 idle ならロビーへ

# 棒人間のポーズ。状態ごとにフレームを持ち、フレームが複数あるものはアニメーションする。
FIGURES = {
    "working": [["\\o/", " | ", "/ \\"], [" o ", "/|\\", "/ >"], ["\\o/", " | ", "< \\"], [" o ", "/|\\", "/ \\"]],
    "idle": [[" o ", "/|\\", "/ \\"]],
    "blocked": [["!o!", " | ", "/ \\"], ["?o?", " | ", "/ \\"]],
    "done": [["\\o ", " |\\", "/ \\"], [" o/", "/| ", "/ \\"]],
    "unknown": [[" ? ", "/|\\", "/ \\"]],
}
FIG_W = 3         # 棒人間の幅
SEAT_W = 13       # 席の幅（名前 6 文字 + 指示回数 [nn] + 隙間 2）
BUBBLE_ROWS = 5   # 吹き出し用に空けておく行数（本文 3 行 + 枠 2 行）
HALL_MARGIN = 2   # 会場の端からステージまでの余白
TABLE_FILL = 0.8  # ステージの最低幅（会場の使える幅に対する割合）
# クリック後、切り替えるまでの待ち。Herdr 0.9.0 以前はクライアントがクリックしたペインの
# space へ引き戻す癖があるので長めに待つ。0.9.1 で修正済み（changelog #3760 #4153 #4171）。
CLICK_DELAY_OLD = 1.2
CLICK_DELAY = 0.2
MOUSE_RESUME_DELAY = 1.0  # 切り替え後、マウス追跡を再開するまでの秒数
FOCUS_WATCH = 2.0   # 切り替え後、戻されていないか監視する秒数
FOCUS_RETRIES = 3   # 戻されたときに切り替え直す最大回数

# guest に付ける名前（ローマ字、6 文字以内）
NAMES = [
    "Taro", "Hanako", "Kenta", "Misaki", "Shota", "Yui", "Daiki", "Hina", "Yuto", "Aoi",
    "Ren", "Rin", "Haruto", "Yuna", "Minato", "Mei", "Itsuki", "Sakura", "Yuma", "Riko",
    "Asahi", "Mugi", "Sota", "An", "Riku", "Koharu", "Aoto", "Mio", "Ritsu", "Uta",
    "Kaede", "Hotaru", "Haruka", "Subaru", "Hiro", "Natsu", "Haruki", "Kaho", "Akito", "Toma",
    "Kaito", "Sora", "Hoshi", "Hikari", "Momoko", "Umeko", "Matsu", "Yuki", "Niji", "Suzu",
    "Koto", "Ichiro", "Jiro", "Saburo", "Sayuri", "Shizu", "Take", "Akane", "Midori", "Asa",
]


def guest_key(a):
    sess = a.get("agent_session") or {}
    return sess.get("value") or a.get("terminal_id") or a.get("pane_id") or ""


def assign_names(agents):
    """セッション ID から決定的に名前を割り当てる。衝突したら次の名前へ。"""
    names = {}
    taken = set()
    for a in sorted(agents, key=guest_key):
        key = guest_key(a)
        idx = int(hashlib.md5(key.encode()).hexdigest(), 16) % len(NAMES)
        for _ in range(len(NAMES)):
            if NAMES[idx] not in taken:
                break
            idx = (idx + 1) % len(NAMES)
        names[key] = NAMES[idx]
        taken.add(NAMES[idx])
    return names


def debug(msg):
    path = os.environ.get("HERDR_PARTY_LOG")
    if path:
        with open(path, "a") as f:
            f.write(time.strftime("%H:%M:%S") + f".{int(time.time() * 1000) % 1000:03d} " + msg + "\n")


# ---------- 文字幅ユーティリティ ----------

def cw(ch):
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def wlen(s):
    """端末での表示幅（全角 = 2、ANSI は無視）。"""
    return sum(cw(ch) for ch in ANSI_RE.sub("", s))


def wtrunc(s, width):
    """表示幅 width に切り詰める（「…」の幅も含めて width 以内）。"""
    if wlen(s) <= width:
        return s
    if width <= 1:
        return "…" if width == 1 else ""
    out, w = "", 0
    for ch in s:
        c = cw(ch)
        if w + c > width - 1:
            break
        out += ch
        w += c
    return out + "…"


def wtrunc_ansi(s, width):
    """ANSI を保ったまま表示幅 width に切り詰める。"""
    out, w, i = "", 0, 0
    while i < len(s):
        m = ANSI_RE.match(s, i)
        if m:
            out += m.group(0)
            i = m.end()
            continue
        c = cw(s[i])
        if w + c > width:
            break
        out += s[i]
        w += c
        i += 1
    return out + RESET


def wcenter(s, width):
    pad = max(0, width - wlen(s))
    left = pad // 2
    return " " * left + s + " " * (pad - left)


def wljust(s, width):
    return s + " " * max(0, width - wlen(s))


def short_cwd(path):
    home = os.path.expanduser("~")
    if path and path.startswith(home):
        return "~" + path[len(home):]
    return path or "-"


def fmt_duration(sec):
    if sec is None:
        return ""
    sec = int(sec)
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m"
    return f"{sec // 3600}h"


# ---------- herdr ----------

HERDR_BIN = os.environ.get("HERDR_BIN_PATH") or "herdr"


def herdr(*args):
    try:
        out = subprocess.run([HERDR_BIN, *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def herdr_version():
    """(major, minor, patch)。取れなければ (0, 0, 0)。"""
    try:
        out = subprocess.run([HERDR_BIN, "--version"], capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"(\d+)\.(\d+)\.(\d+)", out)
        return tuple(int(x) for x in m.groups()) if m else (0, 0, 0)
    except (OSError, subprocess.TimeoutExpired):
        return (0, 0, 0)


def fetch(kind_filter):
    agents = herdr("agent", "list")
    workspaces = herdr("workspace", "list")
    if agents is None or workspaces is None:
        return None
    agents = agents["result"]["agents"]
    if kind_filter:
        agents = [a for a in agents if a.get("agent") == kind_filter]
    ws_order = {w["workspace_id"]: w.get("number", 0) for w in workspaces["result"]["workspaces"]}
    agents.sort(key=lambda a: (ws_order.get(a["workspace_id"], 0), a["workspace_id"], a["tab_id"], a["pane_id"]))
    return agents, workspaces["result"]["workspaces"]


def term_size():
    size = shutil.get_terminal_size((80, 24))
    return size.columns, size.lines


def state_file_path():
    base = os.environ.get("HERDR_PLUGIN_STATE_DIR") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "herdr-party")
    return os.path.join(base, "state-since.json")


class StateTracker:
    """guest ごとに、いまの状態になった時刻（wall clock）を覚えておく。

    ファイルに保存しておき、ビューアを開き直しても同じ状態が続いていれば経過時間を引き継ぐ。
    """

    def __init__(self):
        self.since = {}  # key -> (status, unix_time | None)。None は変化を見ていない
        self.path = state_file_path()
        self.stored = {}
        try:
            with open(self.path) as f:
                self.stored = {k: (v[0], v[1]) for k, v in json.load(f).items()}
        except (OSError, ValueError, TypeError):
            self.stored = {}

    def update(self, agents):
        now = time.time()
        seen = set()
        changed = False
        for a in agents:
            key = guest_key(a)
            seen.add(key)
            st = a.get("agent_status", "unknown")
            prev = self.since.get(key)
            if prev is None:
                stored = self.stored.get(key)
                if stored and stored[0] == st and stored[1] is not None:
                    self.since[key] = (st, stored[1])  # 前回のビューアが見た変化を引き継ぐ
                else:
                    self.since[key] = (st, None)
                    changed = True
            elif prev[0] != st:
                self.since[key] = (st, now)
                changed = True
        for key in list(self.since):
            if key not in seen:
                del self.since[key]
                changed = True
        if changed:
            self.save()

    def save(self):
        try:
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            tmp = self.path + ".tmp"
            with open(tmp, "w") as f:
                json.dump({k: [st, ts] for k, (st, ts) in self.since.items()}, f)
            os.replace(tmp, self.path)
        except OSError:
            pass

    def elapsed(self, a):
        """いまの状態になってからの秒数。変化を見ていなければ None。"""
        rec = self.since.get(guest_key(a))
        if rec is None or rec[1] is None:
            return None
        return time.time() - rec[1]


# ---------- 描画 ----------

class View:
    """描画に必要な状態をひとまとめにする。"""

    def __init__(self):
        self.frame = 0
        self.hover_key = None
        self.selected_key = None
        self.show_help = False
        self.tracker = StateTracker()
        self.names = {}
        self.order = []   # 表示順の guest（キーボード選択用）
        self.git = GitInfo()
        self.context = ContextCache()
        self.prompts = PromptCounter()
        self.next_key = None  # 「次はここ」の guest（承認待ち → 完了、待ちが長い順の先頭）
        self.lobby_after = LOBBY_AFTER
        self.last_seen = {}  # pane_id -> 最後にフォーカスされた時刻（wall clock）
        self.hits = []    # (x0, x1, y0, y1, ("guest", agent) | ("table", ws_id))


def wide_bubble(a, center_x, inner_w, tail_side, view):
    """ホバー中／選択中の guest の吹き出し。会場の内側 (幅 inner_w) に収まる位置に置く。

    1 行目: 状態・名前・経過時間・最後に見てからの時間
    2 行目: 最後に頼んだこと（❯）
    3 行目: 最後の応答の冒頭（⏺）か、承認待ちの内容
    """
    st = a.get("agent_status", "unknown")
    color = STATUS_COLOR.get(st, STATUS_COLOR["unknown"])
    title = view.names.get(guest_key(a), "")
    count = view.prompts.get(a)
    if count is not None:
        title += f" [{count}]"
    elapsed = view.tracker.elapsed(a)
    seen = view.last_seen.get(a.get("pane_id"))
    tail_bits = []
    if elapsed is not None:
        tail_bits.append(fmt_duration(elapsed))
    if seen is not None and not a.get("focused"):
        tail_bits.append(f"見てから {fmt_duration(time.time() - seen)}")
    tail_txt = ("  " + " · ".join(tail_bits)) if tail_bits else ""
    asked, answer = view.context.get(a)
    rows_txt = []
    max_body = max(12, inner_w - HALL_MARGIN * 2 - 4)
    want = wlen(title) + 2 + wlen(tail_txt)
    if asked:
        want = max(want, wlen(asked) + 2)
    if answer:
        want = max(want, wlen(answer) + 2)
    body_w = min(max_body, want)
    text_w = body_w - 2 - wlen(tail_txt)
    if text_w < 6:
        tail_txt, text_w = "", body_w - 2
    rows_txt.append(color + ICON.get(st, "?") + RESET + " " + BOLD + wljust(wtrunc(title, text_w), text_w) + RESET + fg(GRAY) + tail_txt + RESET)
    if asked:
        rows_txt.append(fg(SOFT) + "❯ " + RESET + wljust(wtrunc(asked, body_w - 2), body_w - 2))
    if answer:
        mark = (fg(RED) + "? ") if st == "blocked" else (fg(SOFT) + "⏺ ")
        rows_txt.append(mark + RESET + fg(GRAY) + wljust(wtrunc(answer, body_w - 2), body_w - 2) + RESET)
    bw = body_w + 4
    x = max(HALL_MARGIN, min(center_x - bw // 2, inner_w - HALL_MARGIN - bw))
    tail = center_x - x - 1
    top = ["─"] * (bw - 2)
    bottom = ["─"] * (bw - 2)
    if 0 <= tail < bw - 2:
        if tail_side == "down":
            bottom[tail] = "┬"
        else:
            top[tail] = "┴"
    border = fg(SOFT)
    rows = [border + "╭" + "".join(top) + "╮" + RESET]
    rows += [border + "│" + RESET + " " + r + " " + border + "│" + RESET for r in rows_txt]
    rows.append(border + "╰" + "".join(bottom) + "╯" + RESET)
    rows = [" " * x + r for r in rows]
    # 予約した行数に合わせ、上側の客なら上を、下側なら下を空ける
    padding = [""] * max(0, BUBBLE_ROWS - len(rows))
    return (padding + rows) if tail_side == "down" else (rows + padding)


def figure_glyphs(a, frame, dim=False):
    st = a.get("agent_status", "unknown")
    frames = FIGURES.get(st, FIGURES["unknown"])
    f = frames[frame % len(frames)]
    color = fg(SOFT) if dim else STATUS_COLOR.get(st, STATUS_COLOR["unknown"])
    rows = []
    for k in range(3):
        if st == "working":
            # 稼働中は 1 文字ごとに虹色をずらして光らせる
            rows.append("".join(
                (fg(RAINBOW[(frame * 2 + i * 3 + k * 2) % len(RAINBOW)]) + ch + RESET) if ch != " " else " "
                for i, ch in enumerate(f[k])
            ))
        else:
            rows.append(color + f[k] + RESET)
    return rows


def draw_guests(row, view, inner_w, above, x0, y0, lead_x=None, lobby=False):
    """棒人間 1 列ぶん。x0 は席の左端（会場内側の x）、y0 は最初の行の body 行番号。

    above=True なら吹き出し→名前→棒人間、False なら棒人間→名前→吹き出し。
    lead_x を渡すと行頭の空白をその幅にする（区画を横に連結するときは 0）。
    """
    fig_x = (SEAT_W - 2 - FIG_W) // 2
    name_row = ""
    time_row = ""
    fig_rows = ["", "", ""]
    # この列で出す幅広の吹き出し（ホバー優先、なければ選択中）
    wide = None
    for i, a in enumerate(row):
        key = guest_key(a)
        if key == view.hover_key or (wide is None and key == view.selected_key):
            wide = (a, x0 + i * SEAT_W + fig_x + 1)
            if key == view.hover_key:
                break
    bubble_rows = [""] * BUBBLE_ROWS
    if wide is not None:
        bubble_rows = wide_bubble(wide[0], wide[1], inner_w, "down" if above else "up", view)
    elif above and not lobby and view.next_key is not None:
        # Enter の行き先（次はここ）の頭上に ▼ を出し、0.5 秒ごとに上下させる
        for i, a in enumerate(row):
            if guest_key(a) == view.next_key:
                st = a.get("agent_status", "unknown")
                cx = x0 + i * SEAT_W + fig_x + 1
                glyph = STATUS_COLOR.get(st, "") + BOLD + "▼" + RESET
                marker_row = BUBBLE_ROWS - 1 if view.frame % 2 == 0 else BUBBLE_ROWS - 2
                bubble_rows[marker_row] = " " * cx + glyph
                break
    for i, a in enumerate(row):
        key = guest_key(a)
        st = a.get("agent_status", "unknown")
        name = view.names[key]
        count = view.prompts.get(a)
        label = f"{name} [{count}]" if count is not None else name
        pad_l = max(0, (SEAT_W - 2 - wlen(label)) // 2)
        pad_r = SEAT_W - 2 - wlen(label) - pad_l
        if key == view.selected_key:
            name_col = BOLD + fg(PINK)
        elif key == view.next_key:
            name_col = BOLD + STATUS_COLOR.get(st, fg(NAME))  # 次に行くべき人
        else:
            name_col = fg(SOFT) if lobby else fg(NAME)
        name_row += " " * pad_l + name_col + name + RESET
        if count is not None:
            name_row += fg(SOFT) + f" [{count}]" + RESET
        name_row += " " * max(0, pad_r) + "  "
        # 名前の下に、いまの状態になってからの時間を (54s) のように出す
        elapsed = idle_seconds(a, view) if lobby else (view.tracker.elapsed(a) if st in TIMED_STATES else None)
        time_txt = f"({fmt_duration(elapsed)})" if elapsed is not None else ""
        time_row += fg(SOFT) + wcenter(time_txt, SEAT_W - 2) + RESET + "  "
        glyphs = figure_glyphs(a, view.frame, dim=lobby)
        for k in range(3):
            fig_rows[k] += " " * fig_x + glyphs[k] + " " * (SEAT_W - fig_x - FIG_W)
        sx = x0 + i * SEAT_W
        view.hits.append((sx - 1, sx + SEAT_W - 2, y0, y0 + BUBBLE_ROWS + GUEST_ROWS - 1, ("guest", a)))
    lead = " " * (x0 if lead_x is None else lead_x)
    figure_rows = [lead + name_row, lead + time_row] + [lead + r for r in fig_rows]
    return (bubble_rows + figure_rows) if above else (figure_rows + bubble_rows)


def stage_top(inner, row, color, seat_x=0):
    """ステージの天面。自分のいるセッションの足元は明るくしてスポットライトにする。"""
    cells = [color + "▄" + RESET] * inner
    fig_x = (SEAT_W - 2 - FIG_W) // 2
    for i, a in enumerate(row):
        if a.get("focused"):
            center = seat_x + i * SEAT_W + fig_x + 1
            for pos in range(center - 2, center + 3):
                if 0 <= pos < inner:
                    cells[pos] = fg(LEMON) + "▄" + RESET
    return "".join(cells)


def activity_lines(guests, view, inner, pad):
    """ステージ名の下に、idle でない人ごとに「名前 ▸ 投げたプロンプト」を 1 行ずつ出す。"""
    out = []
    for a in guests:
        if a.get("agent_status") not in TIMED_STATES:
            continue
        act = view.prompts.last_prompt(a)
        if not act:
            continue
        name = view.names.get(guest_key(a), "")
        head = f"{name} ▸ "
        body = wtrunc(act, max(4, inner - wlen(head)))
        out.append(pad + " " + fg(NAME) + head + RESET + fg(GRAY) + body + RESET)
    return out


def render_stage(ws_id, label, guests, view, inner_w, color_n, focused_ws, y_base):
    """ステージひとつぶんの行を返す。y_base は body 内での開始行番号。

    棒人間はステージの上に立つ。1 列に収まらないぶんは後ろの列（上側）に並ぶ。
    ステージは 1 行の台とその下の space 名。自分のいる場所の足元にスポットライト。
    """
    color = fg(color_n)
    max_stage_w = max(SEAT_W + 2, inner_w - HALL_MARGIN * 2)
    min_stage_w = int(max_stage_w * TABLE_FILL)
    stage_w = min(max_stage_w, max(min_stage_w, wlen(label) + 6))
    if len(guests) > max(1, (stage_w - 2) // SEAT_W):
        # 1 列に収まらないなら会場いっぱいまで広げる
        stage_w = max_stage_w
    inner = stage_w - 2
    per_row = max(1, min(len(guests), inner // SEAT_W))
    rows = [guests[i:i + per_row] for i in range(0, len(guests), per_row)]
    offset = max(HALL_MARGIN, (inner_w - stage_w) // 2)
    pad = " " * offset

    def seat_x(n):
        # n 人ぶんの立ち位置をステージの中央に寄せる（縁の内側基準）
        return max(0, (inner - (n * SEAT_W - 2)) // 2)

    lines = []
    # 後ろの列から描く（上に行くほど後ろ）
    for row in reversed(rows[1:]):
        lines.extend(draw_guests(row, view, inner_w, True, offset + 1 + seat_x(len(row)), y_base + len(lines)))
    front_sx = seat_x(len(rows[0]))
    lines.extend(draw_guests(rows[0], view, inner_w, True, offset + 1 + front_sx, y_base + len(lines)))
    view.hits.append((offset, offset + stage_w - 1, y_base + len(lines), y_base + len(lines) + 1, ("table", ws_id)))
    lines.append(pad + " " + stage_top(inner, rows[0], color, seat_x=front_sx))
    # 出演者の cwd から git の状況を集め、相異なるもの（worktree や別リポジトリ）を並べる
    seen = []
    for a in guests:
        info = view.git.get(a.get("cwd") or a.get("foreground_cwd") or "")
        if info and (info["repo"], info["branch"]) not in [(i["repo"], i["branch"]) for i in seen]:
            seen.append(info)
    git_txt = "  ".join(git_summary(i) for i in seen)
    name_txt = (BOLD if focused_ws else "") + color + wtrunc(label, inner) + RESET
    if git_txt and wlen(name_txt) + 2 + wlen(git_txt) <= inner:
        name_txt = name_txt + "  " + git_txt
    lines.append(pad + " " + wcenter(name_txt, inner))
    lines.extend(activity_lines(guests, view, inner, pad))
    lines.append("")
    return lines


DIVIDER_W = 2  # 区画の仕切り "┆ " の幅


def place_labels(spans, labels, inner):
    """各区画の中央にラベルを置く。重なるときは左から順に詰める。"""
    out = ""
    cursor = 0
    for (x, w), label in zip(spans, labels):
        lw = wlen(label)
        x_lab = max(cursor, x + (w - lw) // 2)
        if x_lab + lw > inner:
            x_lab = max(cursor, inner - lw)
        if x_lab < cursor:
            break
        out += " " * (x_lab - wlen(out)) + label
        cursor = x_lab + lw + 2
    return wljust(out, inner)


def render_shared_stage(name, sections, view, inner_w, color_n, y_base):
    """同じリポジトリの worktree を 1 つのステージに並べる。

    sections は [(section_label_text, ws_id, focused_ws, guests), ...]。
    横に収まらなければ None を返す（呼び出し側で区画ごとのステージに分ける）。
    """
    color = fg(color_n)
    max_stage_w = max(SEAT_W + 2, inner_w - HALL_MARGIN * 2)
    inner = max_stage_w - 2
    widths = [len(g) * SEAT_W for _, _, _, g in sections]
    total = sum(widths) + DIVIDER_W * (len(sections) - 1) - 2
    if total > inner:
        return None
    min_stage_w = int(max_stage_w * TABLE_FILL)
    stage_w = min(max_stage_w, max(min_stage_w, total + 2))
    inner = stage_w - 2
    offset = max(HALL_MARGIN, (inner_w - stage_w) // 2)
    pad = " " * offset
    sx0 = max(0, (inner - total) // 2)

    lines = []
    y0 = y_base
    parts = []       # 区画ごとの行（行頭空白なし）
    spans = []       # 区画の (x, 幅)（縁の内側基準）
    x = sx0
    for i, (_, ws_id, _, guests) in enumerate(sections):
        parts.append(draw_guests(guests, view, inner_w, True, offset + 1 + x, y0, lead_x=0))
        spans.append((x, widths[i] - 2))
        x += widths[i] + DIVIDER_W
    n_rows = BUBBLE_ROWS + GUEST_ROWS
    for r in range(n_rows):
        if r < BUBBLE_ROWS:
            # 幅広の吹き出しは絶対位置で 1 区画ぶんしか出ないので、あるものを採用
            lines.append(next((p[r] for p in parts if p[r]), ""))
            continue
        row = pad + " " + " " * sx0
        for i, p in enumerate(parts):
            if i:
                row += fg(SOFT) + "┆" + RESET + " "
            row += p[r]
        lines.append(row)
    # 区画のクリックは、その worktree の space へ
    for (x, w), (_, ws_id, _, _) in zip(spans, sections):
        view.hits.append((offset + 1 + x, offset + 1 + x + w - 1, y_base + len(lines), y_base + len(lines) + 2, ("table", ws_id)))
    front = [g for _, _, _, gs in sections for g in gs]
    # 天面: 区画ごとの立ち位置を合成
    cells = [color + "▄" + RESET] * inner
    fig_x = (SEAT_W - 2 - FIG_W) // 2
    for (x, _), (_, _, _, guests) in zip(spans, sections):
        for i, a in enumerate(guests):
            if a.get("focused"):
                center = x + i * SEAT_W + fig_x + 1
                for pos in range(center - 2, center + 3):
                    if 0 <= pos < inner:
                        cells[pos] = fg(LEMON) + "▄" + RESET
    lines.append(pad + " " + "".join(cells))
    labels = [((BOLD if f else "") + t + RESET) for t, _, f, _ in sections]
    lines.append(pad + " " + place_labels(spans, labels, inner))
    any_focused = any(f for _, _, f, _ in sections)
    lines.append(pad + " " + wcenter((BOLD if any_focused else "") + color + wtrunc(name, inner) + RESET, inner))
    lines.extend(activity_lines(front, view, inner, pad))
    lines.append("")
    return lines


def group_stages(agents, workspaces, view):
    """出演者をステージにまとめる。git が同じリポジトリなら worktree をまたいで 1 つにする。

    返り値: [(name, [(section_text, ws_id, focused_ws, guests), ...]), ...]
    """
    ws_label = {w["workspace_id"]: w.get("label") or w["workspace_id"] for w in workspaces}
    ws_order = {w["workspace_id"]: w.get("number", 0) for w in workspaces}
    ws_focused = {w["workspace_id"]: bool(w.get("focused")) for w in workspaces}
    groups = {}  # key -> {"name", "sections": {skey: {"info", "ws", "guests"}}}
    for a in agents:
        ws_id = a["workspace_id"]
        info = view.git.get(a.get("cwd") or a.get("foreground_cwd") or "")
        if info:
            gkey = ("git", info["common"])
            name = os.path.basename(info["main"].rstrip("/")) or ws_label.get(ws_id, ws_id)
            skey = (info["repo"], ws_id)
        else:
            gkey = ("ws", ws_id)
            name = ws_label.get(ws_id, ws_id)
            skey = ("ws", ws_id)
        g = groups.setdefault(gkey, {"name": name, "sections": {}})
        sec = g["sections"].setdefault(skey, {"info": info, "ws": ws_id, "guests": []})
        sec["guests"].append(a)

    def sec_order(item):
        skey, sec = item
        info = sec["info"]
        is_main = 0 if (info and info["repo"] == info["main"]) else 1
        return (is_main, ws_order.get(sec["ws"], 0), sec["ws"])

    out = []
    for gkey, g in groups.items():
        sections = []
        for skey, sec in sorted(g["sections"].items(), key=sec_order):
            info = sec["info"]
            text = git_summary(info) if info else ""
            sections.append((text, sec["ws"], ws_focused.get(sec["ws"], False), sec["guests"]))
        first_ws = min((ws_order.get(sec["ws"], 0), sec["ws"]) for sec in g["sections"].values())
        out.append((first_ws, g["name"], sections))
    out.sort(key=lambda t: t[0])
    return [(name, sections) for _, name, sections in out]


def idle_seconds(a, view):
    """idle になってからの秒数。ビューアが変化を見ていなければ会話ログの最終記録から数える。"""
    if a.get("agent_status") != "idle":
        return None
    elapsed = view.tracker.elapsed(a)
    if elapsed is not None:
        return elapsed
    last = view.prompts.last_activity(a)
    if last is not None:
        return max(0.0, time.time() - last)
    return None


def split_lobby(agents, view):
    """ステージに立つ人と、ロビーに下がる人（長く idle）に分ける。"""
    if view.lobby_after <= 0:
        return agents, []
    stage, lobby = [], []
    for a in agents:
        sec = idle_seconds(a, view)
        (lobby if sec is not None and sec >= view.lobby_after else stage).append(a)
    lobby.sort(key=lambda a: -(idle_seconds(a, view) or 0))
    return stage, lobby


def render_lobby(lobby, view, inner_w, y_base):
    """ステージの下のロビー。長く idle の人が薄い色で並ぶ。"""
    lines = []
    title = " lobby "
    side = max(0, (inner_w - wlen(title)) // 2)
    lines.append(fg(SOFT) + "┈" * side + title + "┈" * (inner_w - side - wlen(title)) + RESET)
    per_row = max(1, (inner_w - HALL_MARGIN * 2) // SEAT_W)
    for start in range(0, len(lobby), per_row):
        row = lobby[start:start + per_row]
        x0 = max(HALL_MARGIN, (inner_w - (len(row) * SEAT_W - 2)) // 2)
        lines.extend(draw_guests(row, view, inner_w, True, x0, y_base + len(lines), lobby=True))
    lines.append("")
    return lines



def attention_list(agents, view):
    """要注意の guest を、待っている時間が長い順に返す。"""
    att = [a for a in agents if a.get("agent_status") in ATTENTION]
    att.sort(key=lambda a: (0 if a.get("agent_status") == "blocked" else 1, -(view.tracker.elapsed(a) or 0)))
    return att


def rainbow_text(text, frame):
    """1 文字ずつ虹色をずらして流す（踊っている棒人間と同じ色の並び）。"""
    return "".join(
        (fg(RAINBOW[(frame * 2 + i * 2) % len(RAINBOW)]) + ch) if ch != " " else " "
        for i, ch in enumerate(text)
    ) + RESET


def render_header(agents, view, inner_w):
    clock = time.strftime("%H:%M:%S")
    counts = {k: 0 for k in ICON}
    for a in agents:
        st = a.get("agent_status", "unknown")
        counts[st] = counts.get(st, 0) + 1
    # 誰も踊っていないときは虹色のまま止める
    parts = [rainbow_text(f"{counts['working']} dancing", view.frame if counts["working"] else 0)]
    if counts["blocked"]:
        parts.append(f"{fg(RED)}{BOLD}{counts['blocked']} waiting{RESET}")
    if counts["done"]:
        parts.append(f"{fg(CYAN)}{counts['done']} done{RESET}")
    parts.append(f"{fg(SAGE)}{counts['idle']} chilling{RESET}")
    stats = "   ".join(parts)
    left = max(0, (inner_w - wlen(stats)) // 2)
    gap = inner_w - left - wlen(stats) - wlen(clock) - 1
    if gap < 1:
        left = HALL_MARGIN
        gap = inner_w - left - wlen(stats) - wlen(clock) - 1
    lines = []
    if gap >= 1:
        lines.append(" " * left + stats + " " * gap + fg(SOFT) + clock + RESET)
    else:
        lines.append(wcenter(stats, inner_w))
    att = attention_list(agents, view)
    if att:
        chips = []
        for a in att:
            st = a.get("agent_status", "unknown")
            color = STATUS_COLOR.get(st, "")
            dur = fmt_duration(view.tracker.elapsed(a))
            mark = (BOLD + "⏎ ") if guest_key(a) == view.next_key else ""
            chips.append(f"{color}{mark}{view.names[guest_key(a)]}{RESET}" + (f" {fg(GRAY)}{dur}{RESET}" if dur else ""))
        lines.append(wcenter("   ".join(chips), inner_w))
    lines.append(fg(SOFT) + "┈" * inner_w + RESET)
    return lines


HELP_TEXT = "Enter 次へ / 選んだ人へ  ←→ 選ぶ  Tab 要注意  Esc 解除  q 終了"


def render_party(agents, workspaces, view, cols, rows_n):
    """描画行を返す。view.hits と view.order を更新する。"""
    inner_w = max(20, cols)
    view.hits = []
    stage_agents, lobby = split_lobby(agents, view)
    att = attention_list(stage_agents, view)
    view.next_key = guest_key(att[0]) if att else None
    view.order = [guest_key(a) for a in stage_agents] + [guest_key(a) for a in lobby]
    body = render_header(stage_agents, view, inner_w)

    if not agents:
        body.append("")
        body.append(wcenter(fg(GRAY) + "( 会場に誰もいません )" + RESET, inner_w))
    else:
        for idx, (name, sections) in enumerate(group_stages(stage_agents, workspaces, view)):
            color_n = TABLE_PALETTE[idx % len(TABLE_PALETTE)]
            rendered = None
            if len(sections) > 1:
                rendered = render_shared_stage(name, sections, view, inner_w, color_n, len(body))
            if rendered is not None:
                body.extend(rendered)
                continue
            # 区画が 1 つ、または横に収まらないときは区画ごとに別のステージ
            for text, ws_id, focused_ws, guests in sections:
                body.extend(render_stage(ws_id, name, guests, view, inner_w, color_n, focused_ws, len(body)))

    if lobby:
        body.extend(render_lobby(lobby, view, inner_w, len(body)))
    lines = [wljust(wtrunc_ansi(l, inner_w), inner_w) for l in body]
    if view.show_help:
        help_line = wcenter(fg(GRAY) + wtrunc(HELP_TEXT, inner_w) + RESET, inner_w)
        lines = lines[: rows_n - 1] + [" " * inner_w] * max(0, rows_n - 1 - len(lines)) + [help_line]
    return lines[:rows_n]


def hit_test(hits, col, row):
    """端末座標 (1 始まり) から対象を探す。body は画面左上 (1,1) から始まる。"""
    x = col - 1
    y = row - 1
    for x0, x1, y0, y1, target in hits:
        if x0 <= x <= x1 and y0 <= y <= y1:
            return target
    return None


def hover_target(hits, col, row):
    t = hit_test(hits, col, row)
    if t is not None and t[0] == "guest":
        return guest_key(t[1])
    return None


def render_list(agents, view, cols, interval, kind_filter):
    lines = [f"{fg(SOFT)}{time.strftime('%H:%M:%S')}{RESET}", fg(SOFT) + "─" * cols + RESET]
    for a in agents:
        st = a.get("agent_status", "unknown")
        color = STATUS_COLOR.get(st, STATUS_COLOR["unknown"])
        title = a.get("terminal_title_stripped") or a.get("terminal_title") or "-"
        mark = BOLD + "▶ " + RESET if a.get("focused") else "  "
        lines.append(f"{mark}{color}{ICON.get(st, '?')}{RESET} {BOLD}{view.names[guest_key(a)]}{RESET}  {title}")
        extra = f"  {fg(GRAY)}{a.get('agent')}{RESET}" if not kind_filter else ""
        lines.append(f"    {fg(GRAY)}{a['workspace_id']} · {a['pane_id']}{RESET}  {color}{st}{fmt_duration(view.tracker.elapsed(a))}{RESET}{extra}")
        lines.append(f"    {fg(SOFT)}{short_cwd(a.get('cwd'))}{RESET}")
    if not agents:
        lines.append(f"{fg(GRAY)}(エージェントが見つかりません){RESET}")
    lines.append("")
    lines.append(f"{fg(GRAY)}q: quit   {interval}s ごとに更新{RESET}")
    return lines


# ---------- 指示の回数（Claude Code の会話ログから） ----------

CLAUDE_PROJECTS = os.path.expanduser("~/.claude/projects")


def tool_activity(entry):
    """assistant の行からツール実行の要約を 1 つ取り出す。なければ None。"""
    if entry.get("type") != "assistant":
        return None
    content = (entry.get("message") or {}).get("content")
    if not isinstance(content, list):
        return None
    text = None
    for block in content:
        if not isinstance(block, dict) or block.get("type") != "tool_use":
            continue
        name = block.get("name") or "?"
        inp = block.get("input") or {}
        desc = inp.get("description") if isinstance(inp.get("description"), str) else None
        if desc:
            text = desc.strip()
        elif isinstance(inp.get("file_path"), str):
            text = f"{name} {os.path.basename(inp['file_path'])}"
        elif isinstance(inp.get("pattern"), str):
            text = f"{name} {inp['pattern']}"
        elif isinstance(inp.get("prompt"), str):
            text = f"{name}: {inp['prompt'].strip().splitlines()[0][:60]}"
        else:
            text = name
    return text


def prompt_text(entry):
    """ユーザーの指示の本文（1 行目）。"""
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, list):
        content = next((b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"), "")
    if not isinstance(content, str):
        return ""
    text = content.strip()
    # /goal などのスラッシュコマンドはコマンド名だけにする
    m = re.search(r"<command-name>([^<]+)</command-name>", text)
    if m:
        args = re.search(r"<command-args>([^<]*)</command-args>", text)
        text = m.group(1).strip() + ((" " + args.group(1).strip()) if args and args.group(1).strip() else "")
    return text.splitlines()[0].strip() if text else ""


def is_user_prompt(entry):
    """会話ログの 1 行がユーザーの指示かどうか。ツール結果やシステム由来の行は除く。"""
    if entry.get("type") != "user" or entry.get("isMeta"):
        return False
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, str):
        return bool(content.strip())
    if isinstance(content, list):
        return not any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content)
    return False


class PromptCounter:
    """セッション ID から Claude Code の会話ログ（JSONL）を見つけ、指示の回数を差分で数える。"""

    def __init__(self):
        self.lock = threading.Lock()
        self.state = {}   # session_id -> {"path", "offset", "count", "buf", "looked"}
        self.busy = False

    def get(self, a):
        sid = ((a.get("agent_session") or {}).get("value")) or ""
        rec = self.state.get(sid)
        return rec["count"] if rec and rec.get("path") else None

    def last_prompt(self, a):
        """最後に投げたプロンプト（1 行目）。なければ None。"""
        sid = ((a.get("agent_session") or {}).get("value")) or ""
        rec = self.state.get(sid)
        return rec.get("last_prompt") if rec else None

    def activity(self, a):
        """直近のツール実行の説明（いま何をしているか）。なければ None。"""
        sid = ((a.get("agent_session") or {}).get("value")) or ""
        rec = self.state.get(sid)
        return rec.get("activity") if rec else None

    def last_activity(self, a):
        """会話ログの最終記録時刻（unix 秒）。なければ None。"""
        sid = ((a.get("agent_session") or {}).get("value")) or ""
        rec = self.state.get(sid)
        ts = rec.get("last_ts") if rec else None
        if not ts:
            return None
        try:
            return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None


    def refresh(self, agents):
        with self.lock:
            if self.busy:
                return
            self.busy = True
        sids = [((a.get("agent_session") or {}).get("value")) or "" for a in agents]
        threading.Thread(target=self._update, args=([sid for sid in sids if sid],), daemon=True).start()

    def _update(self, sids):
        try:
            for sid in sids:
                rec = self.state.setdefault(sid, {"path": None, "offset": 0, "count": 0, "buf": b"", "looked": 0.0, "last_ts": None, "activity": None, "last_prompt": None})
                if rec["path"] is None:
                    if time.monotonic() - rec["looked"] < 30:
                        continue
                    rec["looked"] = time.monotonic()
                    hits = glob.glob(os.path.join(CLAUDE_PROJECTS, "*", sid + ".jsonl"))
                    if not hits:
                        continue
                    rec["path"] = hits[0]
                try:
                    with open(rec["path"], "rb") as f:
                        f.seek(rec["offset"])
                        chunk = f.read()
                except OSError:
                    continue
                if not chunk:
                    continue
                rec["offset"] += len(chunk)
                data = rec["buf"] + chunk
                parts = data.split(b"\n")
                rec["buf"] = parts.pop()  # 書きかけの最後の行は次回へ
                added = 0
                for line in parts:
                    if not line.strip():
                        continue
                    try:
                        entry = json.loads(line)
                    except ValueError:
                        continue
                    ts = entry.get("timestamp")
                    if isinstance(ts, str):
                        rec["last_ts"] = ts
                    if is_user_prompt(entry):
                        added += 1
                        rec["activity"] = None  # 新しい依頼が来たら前の作業の説明は消す
                        rec["last_prompt"] = prompt_text(entry)
                    act = tool_activity(entry)
                    if act:
                        rec["activity"] = act
                rec["count"] += added
        finally:
            with self.lock:
                self.busy = False



# ---------- 文脈スニペット（頼んだこと・応答・承認待ちの内容） ----------

TOOL_CALL_RE = re.compile(r"^⏺ [A-Za-z][A-Za-z0-9_]*\(")


def herdr_text(*args):
    try:
        out = subprocess.run([HERDR_BIN, *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return out.stdout if out.returncode == 0 else ""


def extract_context(recent, detection, status):
    """画面テキストから (最後に頼んだこと, 最後の応答の冒頭 or 承認待ちの内容) を取り出す。"""
    asked = ""
    answer = ""
    for line in recent.splitlines():
        t = line.strip()
        if t.startswith("❯ ") and len(t) > 2:
            asked = t[2:].strip()
        elif t.startswith("⏺ ") and not TOOL_CALL_RE.match(t) and len(t) > 2:
            answer = t[2:].strip()
    if status == "blocked":
        question = extract_question(detection)
        if question:
            answer = question
    return asked, answer


def extract_question(detection):
    """承認ダイアログや質問の箱から、種類と内容の 1 行を作る。"""
    lines = [l.rstrip() for l in detection.splitlines()]
    box = []
    for l in reversed(lines):
        t = l.strip()
        if t.startswith("╰"):
            box = []
            continue
        if t.startswith("╭"):
            break
        if t.startswith("│"):
            inner = t.strip("│").strip()
            if inner:
                box.insert(0, inner)
    box = [b for b in box if not re.match(r"^(❯\s*)?\d+\.", b) and not b.startswith("Esc")]
    if box:
        head = box[0]
        detail = next((b for b in box[1:] if not b.lower().startswith("do you want")), "")
        return f"{head}: {detail}" if detail else head
    for l in reversed(lines):
        t = l.strip()
        if "?" in t or "？" in t:
            return t.lstrip("│ ").rstrip("│ ")
    return ""


class ContextCache:
    """guest ごとの文脈スニペット。状態が変わったときに別スレッドで取り直す。"""

    def __init__(self):
        self.lock = threading.Lock()
        self.cache = {}    # key -> (status, asked, answer)
        self.pending = set()

    def get(self, a):
        rec = self.cache.get(guest_key(a))
        if rec is None or rec[0] != a.get("agent_status"):
            return "", ""
        return rec[1], rec[2]

    def refresh(self, agents):
        todo = []
        with self.lock:
            for a in agents:
                key = guest_key(a)
                st = a.get("agent_status", "unknown")
                rec = self.cache.get(key)
                if (rec is None or rec[0] != st) and key not in self.pending:
                    self.pending.add(key)
                    todo.append((key, st, a.get("pane_id", "")))
        if todo:
            threading.Thread(target=self._fetch_all, args=(todo,), daemon=True).start()

    def _fetch_all(self, todo):
        for key, st, pane_id in todo:
            recent = herdr_text("agent", "read", pane_id, "--source", "recent-unwrapped", "--lines", "120")
            detection = herdr_text("agent", "read", pane_id, "--source", "detection", "--lines", "40") if st == "blocked" else ""
            asked, answer = extract_context(recent, detection, st)
            with self.lock:
                self.cache[key] = (st, asked, answer)
                self.pending.discard(key)


# ---------- git の状況 ----------

GIT_REFRESH = 10.0  # 秒。イベントで取り直したときも更新する


class GitInfo:
    """cwd ごとのブランチと変更数を別スレッドで取ってキャッシュする。"""

    def __init__(self):
        self.lock = threading.Lock()
        self.cache = {}  # cwd -> {"repo","branch","changes","ahead","behind"} | None
        self.pending = set()
        self.last = {}

    def get(self, cwd):
        with self.lock:
            return self.cache.get(cwd)

    def refresh(self, cwds, force=False):
        now = time.monotonic()
        todo = [c for c in set(cwds) if c and (force or now - self.last.get(c, 0) >= GIT_REFRESH)]
        with self.lock:
            todo = [c for c in todo if c not in self.pending]
            self.pending.update(todo)
        for c in todo:
            self.last[c] = now
        if todo:
            threading.Thread(target=self._probe_all, args=(todo,), daemon=True).start()

    def _probe_all(self, cwds):
        for c in cwds:
            info = probe_git(c)
            with self.lock:
                self.cache[c] = info
                self.pending.discard(c)


def probe_git(cwd):
    def run(*args):
        try:
            out = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return out.stdout if out.returncode == 0 else None

    top = run("rev-parse", "--show-toplevel")
    if not top:
        return None
    common = (run("rev-parse", "--path-format=absolute", "--git-common-dir") or "").strip()
    if not common:
        common = os.path.join(top.strip(), ".git")
    # 主 worktree のパス（common dir が <main>/.git のとき）。bare などはそのまま
    main = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    status = run("status", "--porcelain", "--branch")
    if status is None:
        return None
    lines = status.splitlines()
    head = lines[0] if lines and lines[0].startswith("## ") else "## ?"
    m = re.match(r"## (?:No commits yet on )?([^. \n]+)(?:\.\.\.(\S+))?(?: \[(.*)\])?", head)
    branch = m.group(1) if m else "?"
    if branch.startswith("HEAD"):
        short = run("rev-parse", "--short", "HEAD")
        branch = "@" + (short or "").strip()
    ahead = behind = 0
    if m and m.group(3):
        am = re.search(r"ahead (\d+)", m.group(3))
        bm = re.search(r"behind (\d+)", m.group(3))
        ahead = int(am.group(1)) if am else 0
        behind = int(bm.group(1)) if bm else 0
    changes = sum(1 for l in lines[1:] if l.strip())
    return {"repo": top.strip(), "common": common, "main": main, "branch": branch,
            "changes": changes, "ahead": ahead, "behind": behind}


def git_summary(info):
    """`master ✱3 ↑1` のような短い文字列（色つき）。"""
    parts = [fg(SOFT) + info["branch"] + RESET]
    if info["changes"]:
        parts.append(fg(PEACH) + f"✱{info['changes']}" + RESET)
    if info["ahead"]:
        parts.append(fg(SOFT) + f"↑{info['ahead']}" + RESET)
    if info["behind"]:
        parts.append(fg(SOFT) + f"↓{info['behind']}" + RESET)
    return " ".join(parts)


# ---------- イベント購読 ----------

LIFECYCLE_EVENTS = ("pane.focused", "workspace.focused", "tab.focused", "pane.updated",
                    "pane.created", "pane.closed", "pane.moved", "pane.exited", "pane.agent_detected",
                    "workspace.renamed", "workspace.closed", "workspace.created")


class EventWatcher:
    """Herdr の socket でイベントを購読し、来たらパイプに 1 バイト書いてメインループを起こす。

    pane.focused はペイン ID を持つので、取り直しを待たずにスポットライトを動かせるよう
    最後にフォーカスされたペインを覚えておく。pane.agent_status_changed はペインごとの購読なので、
    エージェントのいるペインの集合が変わったら接続を張り直す。
    """

    def __init__(self, wake_fd):
        self.wake_fd = wake_fd
        self.path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")
        self.lock = threading.Lock()
        self.focused_pane = None
        self.focused_tab = None   # (tab_id, workspace_id)
        self.last_pane = None     # 最後にフォーカスされたペイン（リセットしない）
        self.dirty = False
        self.pane_ids = ()
        self.sock = None
        self.connected = False
        self.thread = threading.Thread(target=self.run, daemon=True)
        self.thread.start()

    def watch_panes(self, pane_ids):
        pane_ids = tuple(sorted(pane_ids))
        if pane_ids != self.pane_ids:
            self.pane_ids = pane_ids
            sock = self.sock
            if sock is not None:
                try:
                    sock.shutdown(socket.SHUT_RDWR)  # 張り直し
                except OSError:
                    pass

    def take(self):
        """(取り直しが必要か, フォーカスされたペイン ID, フォーカスされたタブ) を返してリセットする。"""
        with self.lock:
            dirty, focused, tab = self.dirty, self.focused_pane, self.focused_tab
            self.dirty, self.focused_pane, self.focused_tab = False, None, None
        return dirty, focused, tab

    def wake(self):
        try:
            os.write(self.wake_fd, b"x")
        except OSError:
            pass

    def run(self):
        backoff = 1.0
        while True:
            try:
                self.serve_once()
                backoff = 1.0
            except OSError:
                pass
            self.connected = False
            time.sleep(backoff)
            backoff = min(backoff * 2, 10.0)

    def serve_once(self):
        subs = [{"type": t} for t in LIFECYCLE_EVENTS]
        subs += [{"type": "pane.agent_status_changed", "pane_id": pid} for pid in self.pane_ids]
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(5)
        sock.connect(self.path)
        self.sock = sock
        f = sock.makefile("rwb")
        f.write((json.dumps({"id": "party", "method": "events.subscribe", "params": {"subscriptions": subs}}) + "\n").encode())
        f.flush()
        ack = json.loads(f.readline() or b"{}")
        if "error" in ack:
            debug(f"subscribe error: {ack['error']}")
            sock.close()
            return
        self.connected = True
        debug(f"subscribed: {len(subs)} subscriptions")
        sock.settimeout(None)
        while True:
            line = f.readline()
            if not line:
                return
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            kind = ev.get("event", "")
            data = ev.get("data") or {}
            debug(f"event {kind} {data.get('pane_id', '')}")
            with self.lock:
                if kind == "pane_focused" and data.get("pane_id"):
                    self.focused_pane = data["pane_id"]
                    self.last_pane = data["pane_id"]
                elif kind == "tab_focused" and data.get("tab_id"):
                    self.focused_tab = (data["tab_id"], data.get("workspace_id", ""))
                elif kind == "workspace_focused":
                    pass  # pane_focused / tab_focused が一緒に来る
                elif kind == "pane_moved":
                    pass  # 自分の引っ越し。レイアウトだけの変化
                else:
                    self.dirty = True
            self.wake()


# ---------- 会場のペインの引っ越し（追従） ----------

FOLLOW_SETTLE = 0.05  # 秒。タブ切り替えが連続したときにまとめる


class Follower:
    """会場のペインを、ユーザーがいるタブの右側へ引っ越させる。"""

    def __init__(self, width, wake=None):
        self.width = width
        self.wake = wake  # 引っ越し完了後にメインループを起こして即描画させる
        self.pane_id = os.environ.get("HERDR_PANE_ID", "")
        self.tab_id = os.environ.get("HERDR_TAB_ID", "")
        self.aliases = {self.pane_id}   # 過去の自分のペイン ID（イベントが古い ID で来ることがある）
        self.lock = threading.Lock()
        self.target = None
        self.moving = False
        self.moved = False
        self.last_move = 0.0

    def is_self(self, pane_id):
        return pane_id in self.aliases

    def request(self, tab_id, ws_id):
        if not tab_id or tab_id == self.tab_id:
            return
        with self.lock:
            self.target = (tab_id, ws_id)
            if self.moving:
                return
            self.moving = True
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        while True:
            time.sleep(FOLLOW_SETTLE)
            with self.lock:
                target, self.target = self.target, None
            if target is None or target[0] == self.tab_id:
                with self.lock:
                    if self.target is None:
                        self.moving = False
                        return
                continue
            ratio = f"{max(0.05, min(0.95, 1 - self.width)):.3f}"
            res = herdr("pane", "move", self.pane_id, "--tab", target[0], "--split", "right", "--ratio", ratio, "--no-focus")
            pane = ((res or {}).get("result") or {}).get("move_result", {}).get("pane") or {}
            if pane.get("pane_id"):
                self.pane_id = pane["pane_id"]
                self.tab_id = pane.get("tab_id", target[0])
                self.aliases.add(self.pane_id)
                self.last_move = time.monotonic()
                self.moved = True
                debug(f"followed to {self.tab_id} as {self.pane_id}")
                if self.wake:
                    self.wake()
            else:
                debug(f"follow move failed: {res}")


# ---------- サイドバーへの報告 ----------

SIDEBAR_POSES = {
    "working": ["\\o/", "/o\\"],
    "idle": [" o "],
    "blocked": ["!o!", "?o?"],
    "done": [" o/", "\\o "],
    "unknown": [" ? "],
}
REPORT_TTL_MS = 8000


def report_tokens(agents, names, frame):
    """各セッションのペインに、名前とポーズを Herdr のメタデータとして報告する。"""
    for a in agents:
        st = a.get("agent_status", "unknown")
        poses = SIDEBAR_POSES.get(st, SIDEBAR_POSES["unknown"])
        pose = poses[frame % len(poses)]
        herdr("pane", "report-metadata", a.get("pane_id", ""), "--source", "herdr-party",
              "--token", f"party_name={names.get(guest_key(a), '')}",
              "--token", f"party_pose={pose}",
              "--ttl-ms", str(REPORT_TTL_MS))


def report_only(kind_filter, interval, once):
    frame = 0
    while True:
        fetched = fetch(kind_filter)
        if fetched is not None:
            report_tokens(fetched[0], assign_names(fetched[0]), frame)
        frame += 1
        if once:
            return 0
        time.sleep(interval)


# ---------- 開く（フォーカス移動） ----------

def focus_target(target, delay):
    """対象のセッション／space に Herdr のフォーカスを移す。戻されたら切り替え直す。"""
    if delay:
        time.sleep(delay)  # Herdr クライアント自身のクリック確定処理が終わるのを待つ
    if target[0] == "guest":
        want_ws = target[1].get("workspace_id")
        call = lambda: herdr("agent", "focus", target[1].get("pane_id", ""))
    else:
        want_ws = target[1]
        call = lambda: herdr("workspace", "focus", want_ws)
    res = call()
    debug(f"focus {target[0]} -> {'ok' if res else res}")
    if not res or not want_ws or want_ws == os.environ.get("HERDR_WORKSPACE_ID"):
        return
    # Herdr クライアントがクリック直後に元の space へ戻すことがあるので、しばらく監視する。
    started = time.monotonic()
    retries = 0
    while time.monotonic() - started < FOCUS_WATCH:
        time.sleep(0.1)
        ws = herdr("workspace", "list")
        if not ws:
            continue
        cur = next((w["workspace_id"] for w in ws["result"]["workspaces"] if w.get("focused")), None)
        if cur == want_ws:
            continue
        if retries >= FOCUS_RETRIES:
            debug(f"still {cur} after {retries} retries")
            return
        retries += 1
        debug(f"bounced back to {cur} at +{time.monotonic() - started:.2f}s; refocusing {want_ws} (retry {retries})")
        call()


# ---------- 入力 ----------

def parse_input(data):
    """入力バイト列を (最後のマウス座標, 左クリック座標のリスト, キーのリスト) に分ける。"""
    pos = None
    clicks = []
    for m in MOUSE_RE.finditer(data):
        button = int(m.group(1))
        pos = (int(m.group(2)), int(m.group(3)))
        # 左ボタンを離したときをクリックとみなす
        if button == 0 and m.group(4) == b"m":
            clicks.append(pos)
    rest = MOUSE_RE.sub(b"", data)
    keys = []
    for m in KEY_RE.finditer(rest):
        if m.group(1):
            keys.append({b"A": "up", b"B": "down", b"C": "right", b"D": "left"}[m.group(1)])
        elif m.group(0) == b"\x1b":
            keys.append("esc")
        else:
            ch = m.group(0)
            if ch in (b"\r", b"\n"):
                keys.append("enter")
            elif ch == b"\t":
                keys.append("tab")
            else:
                keys.append(ch.decode("ascii", "replace"))
    return pos, clicks, keys


def main():
    args = sys.argv[1:]
    interval = 2.0
    kind_filter = "claude"
    mode = "party"
    report = False
    once = False
    follow = True
    width = 0.3
    lobby_after = LOBBY_AFTER
    while args:
        a = args.pop(0)
        if a == "--follow":
            follow = True
        elif a == "--no-follow":
            follow = False
        elif a == "--lobby-after":
            lobby_after = float(args.pop(0)) * 60 if args else LOBBY_AFTER
        elif a == "--width":
            width = float(args.pop(0)) if args else 0.3
        elif a == "--all":
            kind_filter = ""
        elif a == "--interval":
            interval = float(args.pop(0)) if args else 2.0
        elif a == "--list":
            mode = "list"
        elif a == "--report":
            report = True
        elif a == "--report-only":
            mode = "report"
        elif a == "--once":
            once = True
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            print(f"unknown option: {a}", file=sys.stderr)
            return 2

    if mode == "report":
        try:
            return report_only(kind_filter, interval, once)
        except KeyboardInterrupt:
            return 0

    if os.environ.get("HERDR_ENV") != "1":
        print("herdr-party-agents: Herdr のペイン内で実行してください (HERDR_ENV=1 が必要)", file=sys.stderr)
        return 1

    is_tty = sys.stdin.isatty()
    old_attrs = None
    fd = sys.stdin.fileno()
    if is_tty:
        import termios
        import tty
        old_attrs = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    sys.stdout.write(ESC + "[?25l")
    if is_tty and mode == "party":
        sys.stdout.write(MOUSE_ON)
    sys.stdout.flush()

    tick = 0.5 if mode == "party" else interval
    click_delay = CLICK_DELAY_OLD if herdr_version() < (0, 9, 1) else CLICK_DELAY
    view = View()
    view.lobby_after = lobby_after
    data = None
    last_fetch = 0.0
    mouse_resume_at = None
    worker = None
    wake_r, wake_w = os.pipe()
    watcher = EventWatcher(wake_w)
    follower = Follower(width, watcher.wake) if (follow and mode == "party" and os.environ.get("HERDR_PANE_ID")) else None
    need_fetch = False

    def apply_focus(pane_id):
        """pane.focused を取り直しを待たずに反映する。"""
        if data is None:
            return False
        changed = False
        for a in data[0]:
            want = a.get("pane_id") == pane_id
            if bool(a.get("focused")) != want:
                a["focused"] = want
                changed = True
        for w in data[1]:
            want = w.get("workspace_id") == pane_id.split(":")[0]
            if bool(w.get("focused")) != want:
                w["focused"] = want
                changed = True
        return changed

    def start_focus(target, delay):
        nonlocal worker, mouse_resume_at
        if worker is not None and worker.is_alive():
            return
        sys.stdout.write(MOUSE_OFF)
        sys.stdout.flush()
        mouse_resume_at = time.monotonic() + delay + MOUSE_RESUME_DELAY
        worker = threading.Thread(target=focus_target, args=(target, delay), daemon=True)
        worker.start()

    def guest_by_key(key):
        if data is None:
            return None
        return next((a for a in data[0] if guest_key(a) == key), None)

    def move_selection(step):
        if not view.order:
            return
        if view.selected_key not in view.order:
            view.selected_key = view.order[0] if step > 0 else view.order[-1]
            return
        i = (view.order.index(view.selected_key) + step) % len(view.order)
        view.selected_key = view.order[i]

    def jump_attention():
        if data is None:
            return
        att = [guest_key(a) for a in attention_list(data[0], view)]
        if not att:
            return
        if view.selected_key in att:
            view.selected_key = att[(att.index(view.selected_key) + 1) % len(att)]
        else:
            view.selected_key = att[0]

    try:
        while True:
            now = time.monotonic()
            if data is None or need_fetch or now - last_fetch >= interval:
                fetched = fetch(kind_filter)
                if fetched is not None:
                    data = fetched
                    view.tracker.update(data[0])
                    view.names = assign_names(data[0])
                    watcher.watch_panes(a.get("pane_id", "") for a in data[0])
                    view.git.refresh([a.get("cwd") or a.get("foreground_cwd") or "" for a in data[0]], force=need_fetch)
                    view.context.refresh(data[0])
                    view.prompts.refresh(data[0])
                    for a in data[0]:
                        if a.get("focused"):
                            view.last_seen[a.get("pane_id")] = time.time()
                    if report:
                        threading.Thread(target=report_tokens, args=(data[0], view.names, view.frame), daemon=True).start()
                last_fetch = now
                need_fetch = False
            if mouse_resume_at is not None and time.monotonic() >= mouse_resume_at:
                sys.stdout.write(MOUSE_ON)
                mouse_resume_at = None
            cols, rows_n = term_size()
            if data is None:
                lines = [f"{STATUS_COLOR['blocked']}herdr agent list に失敗しました{RESET}"]
            elif mode == "party":
                lines = render_party(data[0], data[1], view, cols, rows_n)
            else:
                lines = render_list(data[0], view, cols, int(interval), kind_filter)
            sys.stdout.write(ESC + "[H" + ESC + "[2J" + "\n".join(lines[:rows_n]))
            sys.stdout.flush()
            view.frame += 1
            # tick まで入力かイベントを待つ。表示が変わるものがあればすぐ描き直す
            deadline = time.monotonic() + tick
            redraw = False
            while not redraw:
                remain = deadline - time.monotonic()
                if remain <= 0:
                    break
                r, _, _ = select.select([fd, wake_r] if is_tty else [wake_r], [], [], remain)
                if not r:
                    break
                if wake_r in r:
                    os.read(wake_r, 4096)
                    if follower is not None and follower.moved:
                        follower.moved = False
                        redraw = True  # 引っ越し先のサイズで即描画
                    dirty, focused, tab = watcher.take()
                    if focused is not None:
                        view.last_seen[focused] = time.time()
                        if apply_focus(focused):
                            redraw = True
                    if follower is not None and tab is not None:
                        # 自分のペインがクリックされたときは動かない
                        if not (watcher.last_pane and follower.is_self(watcher.last_pane)):
                            follower.request(tab[0], tab[1])
                    if dirty:
                        need_fetch = True
                        redraw = True
                if fd not in r:
                    continue
                raw = os.read(fd, 4096)
                pos, clicks, keys = parse_input(raw)
                for c in clicks:
                    target = hit_test(view.hits, c[0], c[1])
                    debug(f"click col={c[0]} row={c[1]} -> {target and target[0]}")
                    if target is not None:
                        start_focus(target, click_delay)
                if pos is not None:
                    new_key = hover_target(view.hits, pos[0], pos[1])
                    if new_key != view.hover_key:
                        view.hover_key = new_key
                        redraw = True
                for k in keys:
                    if k in ("q", "Q"):
                        return 0
                    elif k in ("right", "down", "l", "j"):
                        move_selection(1)
                        redraw = True
                    elif k in ("left", "up", "h", "k"):
                        move_selection(-1)
                        redraw = True
                    elif k == "tab":
                        jump_attention()
                        redraw = True
                    elif k in ("enter", "o"):
                        a = guest_by_key(view.selected_key) or guest_by_key(view.next_key)
                        if a is not None:
                            start_focus(("guest", a), 0)
                    elif k == "esc":
                        view.selected_key = None
                        redraw = True
                    elif k == "?":
                        view.show_help = not view.show_help
                        redraw = True
            if redraw:
                view.frame -= 1  # ポーズを進めずに描き直す
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write(MOUSE_OFF + ESC + "[?25h" + RESET + "\n")
        sys.stdout.flush()
        if old_attrs is not None:
            import termios
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
    return 0


if __name__ == "__main__":
    sys.exit(main())
