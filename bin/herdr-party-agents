#!/usr/bin/env python3
"""herdr-party-agents: Herdr のセッションを棒人間、space をパーティー会場の机として描画する。

使い方:
  herdr-party-agents [--all] [--interval SEC] [--list]
    --all           claude 以外のエージェントも招待する
    --interval SEC  エージェント情報の更新間隔（秒、デフォルト 2）
    --list          棒人間ではなく一覧表示にする

操作:
  マウス      棒人間に乗せるとタイトル、クリックでそのセッションを開く
  ← → h l    guest を選ぶ（↑ ↓ j k も同じ）
  Tab        要注意（承認待ち・完了）の guest へジャンプ
  Enter / o  選んだ guest のセッションを開く
  Esc        選択を解除
  ?          操作の説明を出す / 消す
  q          終了

環境変数 HERDR_PARTY_LOG にファイルパスを入れると、クリックとフォーカスの経過を記録する。
"""
import hashlib
import json
import os
import re
import select
import shutil
import subprocess
import sys
import threading
import time
import unicodedata

ESC = "\033"
RESET = ESC + "[0m"
BOLD = ESC + "[1m"
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")
MOUSE_RE = re.compile(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
KEY_RE = re.compile(rb"\x1b\[([ABCD])|\x1b|[\x00-\x7f]", re.S)
MOUSE_ON = ESC + "[?1003h" + ESC + "[?1006h"
MOUSE_OFF = ESC + "[?1003l" + ESC + "[?1006l"


def fg(n):
    return f"{ESC}[38;5;{n}m"


# パレット（256 色）
PINK, CYAN, LAVENDER, MINT, PEACH, LEMON, RED = 213, 117, 141, 121, 216, 228, 210
GRAY, SOFT = 245, 240
STATUS_COLOR = {
    "working": fg(LEMON),
    "blocked": fg(RED),
    "done": fg(CYAN),
    "idle": fg(MINT),
    "unknown": fg(GRAY),
}
STATUS_WORD = {"working": "dancing", "blocked": "waiting", "done": "done", "idle": "chilling", "unknown": "?"}
ICON = {"working": "◐", "blocked": "◆", "done": "✔", "idle": "●", "unknown": "?"}
TABLE_PALETTE = [PINK, CYAN, LAVENDER, MINT, PEACH, LEMON]
RAINBOW = [203, 209, 215, 221, 227, 155, 120, 86, 81, 75, 105, 141, 177, 213]  # 稼働中の棒人間を流れる虹色
ATTENTION = ("blocked", "done")  # 常に吹き出しを出す状態

# 棒人間のポーズ。状態ごとにフレームを持ち、フレームが複数あるものはアニメーションする。
FIGURES = {
    "working": [["\\o/", " | ", "/ \\"], [" o ", "/|\\", "/ >"], ["\\o/", " | ", "< \\"], [" o ", "/|\\", "/ \\"]],
    "idle": [[" o ", "/|\\", "/ \\"]],
    "blocked": [["!o!", " | ", "/ \\"], ["?o?", " | ", "/ \\"]],
    "done": [["\\o ", " |\\", "/ \\"], [" o/", "/| ", "/ \\"]],
    "unknown": [[" ? ", "/|\\", "/ \\"]],
}
FIG_W = 3         # 棒人間の幅
SEAT_W = 8        # 席の幅（名前 6 文字 + 隙間 2）
BUBBLE_ROWS = 3   # 吹き出し用に空けておく行数
HALL_MARGIN = 2   # 会場の端から机までの余白
TABLE_FILL = 0.8  # 机の最低幅（会場の使える幅に対する割合）
CLICK_DELAY = 1.2   # クリック後、Herdr クライアント自身のクリック確定処理が終わるのを待つ秒数
MOUSE_RESUME_DELAY = 1.0  # 切り替え後、マウス追跡を再開するまでの秒数
FOCUS_WATCH = 2.0   # 切り替え後、戻されていないか監視する秒数
FOCUS_RETRIES = 3   # 戻されたときに切り替え直す最大回数

# guest に付ける名前（ローマ字、6 文字以内）
NAMES = [
    "Taro", "Hanako", "Kenta", "Misaki", "Shota", "Yui", "Daiki", "Hina", "Yuto", "Aoi",
    "Ren", "Rin", "Haruto", "Yuna", "Minato", "Mei", "Itsuki", "Sakura", "Yuma", "Riko",
    "Asahi", "Mugi", "Sota", "An", "Riku", "Koharu", "Aoto", "Mio", "Ritsu", "Uta",
    "Kaede", "Hotaru", "Haruka", "Subaru", "Hiro", "Natsu", "Haruki", "Kaho", "Akito", "Toma",
    "Kaito", "Sora", "Hoshi", "Hikari", "Momoko", "Umeko", "Matsu", "Yuki", "Niji", "Suzu",
    "Koto", "Ichiro", "Jiro", "Saburo", "Sayuri", "Shizu", "Take", "Akane", "Midori", "Asa",
]


def guest_key(a):
    sess = a.get("agent_session") or {}
    return sess.get("value") or a.get("terminal_id") or a.get("pane_id") or ""


def assign_names(agents):
    """セッション ID から決定的に名前を割り当てる。衝突したら次の名前へ。"""
    names = {}
    taken = set()
    for a in sorted(agents, key=guest_key):
        key = guest_key(a)
        idx = int(hashlib.md5(key.encode()).hexdigest(), 16) % len(NAMES)
        for _ in range(len(NAMES)):
            if NAMES[idx] not in taken:
                break
            idx = (idx + 1) % len(NAMES)
        names[key] = NAMES[idx]
        taken.add(NAMES[idx])
    return names


def debug(msg):
    path = os.environ.get("HERDR_PARTY_LOG")
    if path:
        with open(path, "a") as f:
            f.write(time.strftime("%H:%M:%S ") + msg + "\n")


# ---------- 文字幅ユーティリティ ----------

def cw(ch):
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def wlen(s):
    """端末での表示幅（全角 = 2、ANSI は無視）。"""
    return sum(cw(ch) for ch in ANSI_RE.sub("", s))


def wtrunc(s, width):
    """表示幅 width に切り詰める（「…」の幅も含めて width 以内）。"""
    if wlen(s) <= width:
        return s
    if width <= 1:
        return "…" if width == 1 else ""
    out, w = "", 0
    for ch in s:
        c = cw(ch)
        if w + c > width - 1:
            break
        out += ch
        w += c
    return out + "…"


def wtrunc_ansi(s, width):
    """ANSI を保ったまま表示幅 width に切り詰める。"""
    out, w, i = "", 0, 0
    while i < len(s):
        m = ANSI_RE.match(s, i)
        if m:
            out += m.group(0)
            i = m.end()
            continue
        c = cw(s[i])
        if w + c > width:
            break
        out += s[i]
        w += c
        i += 1
    return out + RESET


def wcenter(s, width):
    pad = max(0, width - wlen(s))
    left = pad // 2
    return " " * left + s + " " * (pad - left)


def wljust(s, width):
    return s + " " * max(0, width - wlen(s))


def short_cwd(path):
    home = os.path.expanduser("~")
    if path and path.startswith(home):
        return "~" + path[len(home):]
    return path or "-"


def fmt_duration(sec):
    if sec is None:
        return ""
    sec = int(sec)
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m"
    return f"{sec // 3600}h"


# ---------- herdr ----------

def herdr(*args):
    try:
        out = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def fetch(kind_filter):
    agents = herdr("agent", "list")
    workspaces = herdr("workspace", "list")
    if agents is None or workspaces is None:
        return None
    agents = agents["result"]["agents"]
    if kind_filter:
        agents = [a for a in agents if a.get("agent") == kind_filter]
    ws_order = {w["workspace_id"]: w.get("number", 0) for w in workspaces["result"]["workspaces"]}
    agents.sort(key=lambda a: (ws_order.get(a["workspace_id"], 0), a["workspace_id"], a["tab_id"], a["pane_id"]))
    return agents, workspaces["result"]["workspaces"]


def term_size():
    size = shutil.get_terminal_size((80, 24))
    return size.columns, size.lines


class StateTracker:
    """guest ごとに、いまの状態になってからの経過時間を覚えておく。"""

    def __init__(self):
        self.since = {}  # key -> (status, monotonic | None)。None は変化を見ていない（起動時からその状態）

    def update(self, agents):
        now = time.monotonic()
        seen = set()
        for a in agents:
            key = guest_key(a)
            seen.add(key)
            st = a.get("agent_status", "unknown")
            prev = self.since.get(key)
            if prev is None:
                self.since[key] = (st, None)
            elif prev[0] != st:
                self.since[key] = (st, now)
        for key in list(self.since):
            if key not in seen:
                del self.since[key]

    def elapsed(self, a):
        """いまの状態になってからの秒数。変化を見ていなければ None。"""
        rec = self.since.get(guest_key(a))
        if rec is None or rec[1] is None:
            return None
        return time.monotonic() - rec[1]


# ---------- 描画 ----------

class View:
    """描画に必要な状態をひとまとめにする。"""

    def __init__(self):
        self.frame = 0
        self.hover_key = None
        self.selected_key = None
        self.show_help = False
        self.tracker = StateTracker()
        self.names = {}
        self.order = []   # 表示順の guest（キーボード選択用）
        self.hits = []    # (x0, x1, y0, y1, ("guest", agent) | ("table", ws_id))


def wide_bubble(a, center_x, inner_w, tail_side, elapsed):
    """ホバー中／選択中の guest の吹き出し。会場の内側 (幅 inner_w) に収まる位置に置く。"""
    st = a.get("agent_status", "unknown")
    color = STATUS_COLOR.get(st, STATUS_COLOR["unknown"])
    title = a.get("terminal_title_stripped") or a.get("terminal_title") or "-"
    tail_txt = f" {fmt_duration(elapsed)}" if elapsed is not None else ""
    max_body = max(8, inner_w - HALL_MARGIN * 2 - 4)
    body_w = min(max_body, wlen(title) + 2 + wlen(tail_txt))
    bw = body_w + 4
    x = max(HALL_MARGIN, min(center_x - bw // 2, inner_w - HALL_MARGIN - bw))
    tail = center_x - x - 1
    top = ["─"] * (bw - 2)
    bottom = ["─"] * (bw - 2)
    if 0 <= tail < bw - 2:
        if tail_side == "down":
            bottom[tail] = "┬"
        else:
            top[tail] = "┴"
    border = fg(SOFT)
    text_w = body_w - 2 - wlen(tail_txt)
    line = color + ICON.get(st, "?") + RESET + " " + BOLD + wljust(wtrunc(title, text_w), text_w) + RESET + fg(GRAY) + tail_txt + RESET
    rows = [
        border + "╭" + "".join(top) + "╮" + RESET,
        border + "│" + RESET + " " + line + " " + border + "│" + RESET,
        border + "╰" + "".join(bottom) + "╯" + RESET,
    ]
    return [" " * x + r for r in rows]


def mini_bubble(a, elapsed, frame, tail_side):
    """要注意の guest に常時出す、席の幅に収まる小さな吹き出し。"""
    st = a.get("agent_status", "unknown")
    color = STATUS_COLOR.get(st, STATUS_COLOR["unknown"])
    bw = SEAT_W - 1  # 7
    text = f"{ICON.get(st, '?')} {fmt_duration(elapsed)}".rstrip()
    body = wcenter(wtrunc(text, bw - 2), bw - 2)
    tail = (bw - 2) // 2
    top = ["─"] * (bw - 2)
    bottom = ["─"] * (bw - 2)
    if tail_side == "down":
        bottom[tail] = "┬"
    else:
        top[tail] = "┴"
    # 承認待ちは 1 秒ごとに明滅させて目を引く
    emphasis = BOLD if (st != "blocked" or frame % 4 < 2) else ""
    return [
        color + "╭" + "".join(top) + "╮" + RESET,
        color + "│" + RESET + emphasis + color + body + RESET + color + "│" + RESET,
        color + "╰" + "".join(bottom) + "╯" + RESET,
    ]


def figure_glyphs(a, frame):
    st = a.get("agent_status", "unknown")
    frames = FIGURES.get(st, FIGURES["unknown"])
    f = frames[frame % len(frames)]
    color = STATUS_COLOR.get(st, STATUS_COLOR["unknown"])
    rows = []
    for k in range(3):
        if st == "working":
            # 稼働中は 1 文字ごとに虹色をずらして光らせる
            rows.append("".join(
                (fg(RAINBOW[(frame * 2 + i * 3 + k * 2) % len(RAINBOW)]) + ch + RESET) if ch != " " else " "
                for i, ch in enumerate(f[k])
            ))
        else:
            rows.append(color + f[k] + RESET)
    return rows


def draw_guests(row, view, inner_w, above, x0, y0):
    """棒人間 1 列ぶん。x0 は席の左端（会場内側の x）、y0 は最初の行の body 行番号。

    above=True なら吹き出し→名前→棒人間、False なら棒人間→名前→吹き出し。
    """
    fig_x = (SEAT_W - 2 - FIG_W) // 2
    name_row = ""
    fig_rows = ["", "", ""]
    # この列で出す幅広の吹き出し（ホバー優先、なければ選択中）
    wide = None
    for i, a in enumerate(row):
        key = guest_key(a)
        if key == view.hover_key or (wide is None and key == view.selected_key):
            wide = (a, x0 + i * SEAT_W + fig_x + 1)
            if key == view.hover_key:
                break
    bubble_rows = [""] * BUBBLE_ROWS
    if wide is not None:
        bubble_rows = wide_bubble(wide[0], wide[1], inner_w, "down" if above else "up", view.tracker.elapsed(wide[0]))
    mini = [""] * BUBBLE_ROWS
    for i, a in enumerate(row):
        key = guest_key(a)
        st = a.get("agent_status", "unknown")
        name = view.names[key]
        name_cell = wcenter(name, SEAT_W - 2) + "  "
        if key == view.selected_key:
            name_row += BOLD + fg(PINK) + name_cell + RESET
        else:
            name_row += fg(GRAY) + name_cell + RESET
        glyphs = figure_glyphs(a, view.frame)
        for k in range(3):
            fig_rows[k] += " " * fig_x + glyphs[k] + " " * (SEAT_W - fig_x - FIG_W)
        if wide is None and st in ATTENTION:
            mb = mini_bubble(a, view.tracker.elapsed(a), view.frame, "down" if above else "up")
            for k in range(BUBBLE_ROWS):
                mini[k] += mb[k] + " "
        else:
            for k in range(BUBBLE_ROWS):
                mini[k] += " " * SEAT_W
        sx = x0 + i * SEAT_W
        view.hits.append((sx - 1, sx + SEAT_W - 2, y0, y0 + BUBBLE_ROWS + 3, ("guest", a)))
    if wide is None:
        bubble_rows = [" " * x0 + m for m in mini]
    lead = " " * x0
    figure_rows = [lead + name_row] + [lead + r for r in fig_rows]
    return (bubble_rows + figure_rows) if above else (figure_rows + bubble_rows)


def table_edge(left, right, inner, row, color, joints=(), seat_x=0):
    """机の縁。座席のある位置に皿 ○（自分のいるセッションは ◉）を置き、joints の位置に脚の付け根 ┳ を置く。"""
    chars = ["━"] * inner
    for pos in joints:
        if 0 <= pos < inner:
            chars[pos] = "┳"
    fig_x = (SEAT_W - 2 - FIG_W) // 2
    for i, a in enumerate(row):
        pos = seat_x + i * SEAT_W + fig_x + 1  # 棒人間の中心（机の内側基準）
        if 0 <= pos < inner:
            chars[pos] = "◉" if a.get("focused") else "○"
    return color + left + "".join(chars) + right + RESET


def table_legs(inner, joints, color):
    chars = [" "] * inner
    for pos in joints:
        if 0 <= pos < inner:
            chars[pos] = "┃"
    return color + " " + "".join(chars) + " " + RESET


def render_table(ws_id, label, guests, view, inner_w, color_n, focused_ws, y_base):
    """机ひとつぶんの行を返す。y_base は body 内での開始行番号。"""
    color = fg(color_n)
    max_table_w = max(SEAT_W + 2, inner_w - HALL_MARGIN * 2)
    min_table_w = int(max_table_w * TABLE_FILL)
    table_w = min(max_table_w, max(min_table_w, wlen(label) + 4))
    if len(guests) > 2 * max(1, (table_w - 2) // SEAT_W):
        # 上下 2 列に収まらないなら机を会場いっぱいまで伸ばす
        table_w = max_table_w
    inner = table_w - 2
    per_row = max(1, min(len(guests), inner // SEAT_W))
    rows = [guests[i:i + per_row] for i in range(0, len(guests), per_row)]
    offset = max(HALL_MARGIN, (inner_w - table_w) // 2)
    pad = " " * offset

    def seat_x(n):
        # n 人ぶんの席を机の中央に寄せる（机の内側基準）
        return max(0, (inner - (n * SEAT_W - 2)) // 2)

    lines = []

    def emit(row, above):
        sx = seat_x(len(row))
        lines.extend(draw_guests(row, view, inner_w, above, offset + 1 + sx, y_base + len(lines)))
        return sx

    top_sx = emit(rows[0], True)
    view.hits.append((offset, offset + table_w - 1, y_base + len(lines), y_base + len(lines) + 2, ("table", ws_id)))
    lines.append(pad + table_edge("┏", "┓", inner, rows[0], color, seat_x=top_sx))
    deco = wcenter(wtrunc(label, inner), inner)
    lines.append(pad + color + "┃" + RESET + (BOLD if focused_ws else "") + color + deco + RESET + color + "┃" + RESET)
    if len(rows) > 1:
        # 下側にも客が座る机は、下辺にも皿を並べる
        lines.append(pad + table_edge("┗", "┛", inner, rows[1], color, seat_x=seat_x(len(rows[1]))))
        for i, row in enumerate(rows[1:]):
            if i > 0:
                lines.append("")
            emit(row, False)
    else:
        joints = (1, inner - 2) if inner >= 4 else (0,)
        lines.append(pad + table_edge("┗", "┛", inner, [], color, joints=joints))
        lines.append(pad + table_legs(inner, joints, color))
        lines.append("")
    return lines


def attention_list(agents, view):
    """要注意の guest を、待っている時間が長い順に返す。"""
    att = [a for a in agents if a.get("agent_status") in ATTENTION]
    att.sort(key=lambda a: (0 if a.get("agent_status") == "blocked" else 1, -(view.tracker.elapsed(a) or 0)))
    return att


def render_header(agents, view, inner_w):
    clock = time.strftime("%H:%M:%S")
    counts = {k: 0 for k in ICON}
    for a in agents:
        st = a.get("agent_status", "unknown")
        counts[st] = counts.get(st, 0) + 1
    parts = [f"{fg(LEMON)}◐ {counts['working']} dancing{RESET}"]
    if counts["blocked"]:
        parts.append(f"{fg(RED)}{BOLD}◆ {counts['blocked']} waiting{RESET}")
    if counts["done"]:
        parts.append(f"{fg(CYAN)}✔ {counts['done']} done{RESET}")
    parts.append(f"{fg(MINT)}● {counts['idle']} chilling{RESET}")
    stats = "   ".join(parts)
    left = max(0, (inner_w - wlen(stats)) // 2)
    gap = inner_w - left - wlen(stats) - wlen(clock) - 1
    if gap < 1:
        left = HALL_MARGIN
        gap = inner_w - left - wlen(stats) - wlen(clock) - 1
    lines = []
    if gap >= 1:
        lines.append(" " * left + stats + " " * gap + fg(SOFT) + clock + RESET)
    else:
        lines.append(wcenter(stats, inner_w))
    att = attention_list(agents, view)
    if att:
        chips = []
        for a in att:
            st = a.get("agent_status", "unknown")
            color = STATUS_COLOR.get(st, "")
            dur = fmt_duration(view.tracker.elapsed(a))
            chips.append(f"{color}{ICON[st]} {view.names[guest_key(a)]}{RESET}" + (f" {fg(GRAY)}{dur}{RESET}" if dur else ""))
        lines.append(wcenter("   ".join(chips), inner_w))
    lines.append(fg(SOFT) + "┈" * inner_w + RESET)
    return lines


HELP_TEXT = "←→ 選ぶ  Tab 要注意へ  Enter/クリック 開く  Esc 解除  q 終了"


def render_party(agents, workspaces, view, cols, rows_n):
    """描画行を返す。view.hits と view.order を更新する。"""
    inner_w = max(20, cols)
    view.hits = []
    view.order = [guest_key(a) for a in agents]
    body = render_header(agents, view, inner_w)

    if not agents:
        body.append("")
        body.append(wcenter(fg(GRAY) + "( 会場に誰もいません )" + RESET, inner_w))
    else:
        ws_label = {w["workspace_id"]: w.get("label") or w["workspace_id"] for w in workspaces}
        ws_order = {w["workspace_id"]: w.get("number", 0) for w in workspaces}
        ws_focused = {w["workspace_id"]: bool(w.get("focused")) for w in workspaces}
        by_ws = {}
        for a in agents:
            by_ws.setdefault(a["workspace_id"], []).append(a)
        for idx, ws_id in enumerate(sorted(by_ws, key=lambda w: (ws_order.get(w, 0), w))):
            color_n = TABLE_PALETTE[idx % len(TABLE_PALETTE)]
            body.extend(render_table(ws_id, ws_label.get(ws_id, ws_id), by_ws[ws_id], view, inner_w, color_n,
                                     ws_focused.get(ws_id, False), len(body)))

    lines = [wljust(wtrunc_ansi(l, inner_w), inner_w) for l in body]
    if view.show_help:
        help_line = wcenter(fg(GRAY) + wtrunc(HELP_TEXT, inner_w) + RESET, inner_w)
        lines = lines[: rows_n - 1] + [" " * inner_w] * max(0, rows_n - 1 - len(lines)) + [help_line]
    return lines[:rows_n]


def hit_test(hits, col, row):
    """端末座標 (1 始まり) から対象を探す。body は画面左上 (1,1) から始まる。"""
    x = col - 1
    y = row - 1
    for x0, x1, y0, y1, target in hits:
        if x0 <= x <= x1 and y0 <= y <= y1:
            return target
    return None


def hover_target(hits, col, row):
    t = hit_test(hits, col, row)
    if t is not None and t[0] == "guest":
        return guest_key(t[1])
    return None


def render_list(agents, view, cols, interval, kind_filter):
    lines = [f"{fg(SOFT)}{time.strftime('%H:%M:%S')}{RESET}", fg(SOFT) + "─" * cols + RESET]
    for a in agents:
        st = a.get("agent_status", "unknown")
        color = STATUS_COLOR.get(st, STATUS_COLOR["unknown"])
        title = a.get("terminal_title_stripped") or a.get("terminal_title") or "-"
        mark = BOLD + "▶ " + RESET if a.get("focused") else "  "
        lines.append(f"{mark}{color}{ICON.get(st, '?')}{RESET} {BOLD}{view.names[guest_key(a)]}{RESET}  {title}")
        extra = f"  {fg(GRAY)}{a.get('agent')}{RESET}" if not kind_filter else ""
        lines.append(f"    {fg(GRAY)}{a['workspace_id']} · {a['pane_id']}{RESET}  {color}{st}{fmt_duration(view.tracker.elapsed(a))}{RESET}{extra}")
        lines.append(f"    {fg(SOFT)}{short_cwd(a.get('cwd'))}{RESET}")
    if not agents:
        lines.append(f"{fg(GRAY)}(エージェントが見つかりません){RESET}")
    lines.append("")
    lines.append(f"{fg(GRAY)}q: quit   {interval}s ごとに更新{RESET}")
    return lines


# ---------- 開く（フォーカス移動） ----------

def focus_target(target, delay):
    """対象のセッション／space に Herdr のフォーカスを移す。戻されたら切り替え直す。"""
    if delay:
        time.sleep(delay)  # Herdr クライアント自身のクリック確定処理が終わるのを待つ
    if target[0] == "guest":
        want_ws = target[1].get("workspace_id")
        call = lambda: herdr("agent", "focus", target[1].get("pane_id", ""))
    else:
        want_ws = target[1]
        call = lambda: herdr("workspace", "focus", want_ws)
    res = call()
    debug(f"focus {target[0]} -> {'ok' if res else res}")
    if not res or not want_ws or want_ws == os.environ.get("HERDR_WORKSPACE_ID"):
        return
    # Herdr クライアントがクリック直後に元の space へ戻すことがあるので、しばらく監視する。
    started = time.monotonic()
    retries = 0
    while time.monotonic() - started < FOCUS_WATCH:
        time.sleep(0.1)
        ws = herdr("workspace", "list")
        if not ws:
            continue
        cur = next((w["workspace_id"] for w in ws["result"]["workspaces"] if w.get("focused")), None)
        if cur == want_ws:
            continue
        if retries >= FOCUS_RETRIES:
            debug(f"still {cur} after {retries} retries")
            return
        retries += 1
        debug(f"bounced back to {cur} at +{time.monotonic() - started:.2f}s; refocusing {want_ws} (retry {retries})")
        call()


# ---------- 入力 ----------

def parse_input(data):
    """入力バイト列を (最後のマウス座標, 左クリック座標のリスト, キーのリスト) に分ける。"""
    pos = None
    clicks = []
    for m in MOUSE_RE.finditer(data):
        button = int(m.group(1))
        pos = (int(m.group(2)), int(m.group(3)))
        # 左ボタンを離したときをクリックとみなす
        if button == 0 and m.group(4) == b"m":
            clicks.append(pos)
    rest = MOUSE_RE.sub(b"", data)
    keys = []
    for m in KEY_RE.finditer(rest):
        if m.group(1):
            keys.append({b"A": "up", b"B": "down", b"C": "right", b"D": "left"}[m.group(1)])
        elif m.group(0) == b"\x1b":
            keys.append("esc")
        else:
            ch = m.group(0)
            if ch in (b"\r", b"\n"):
                keys.append("enter")
            elif ch == b"\t":
                keys.append("tab")
            else:
                keys.append(ch.decode("ascii", "replace"))
    return pos, clicks, keys


def main():
    args = sys.argv[1:]
    interval = 2.0
    kind_filter = "claude"
    mode = "party"
    while args:
        a = args.pop(0)
        if a == "--all":
            kind_filter = ""
        elif a == "--interval":
            interval = float(args.pop(0)) if args else 2.0
        elif a == "--list":
            mode = "list"
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            print(f"unknown option: {a}", file=sys.stderr)
            return 2

    if os.environ.get("HERDR_ENV") != "1":
        print("herdr-party-agents: Herdr のペイン内で実行してください (HERDR_ENV=1 が必要)", file=sys.stderr)
        return 1

    is_tty = sys.stdin.isatty()
    old_attrs = None
    fd = sys.stdin.fileno()
    if is_tty:
        import termios
        import tty
        old_attrs = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    sys.stdout.write(ESC + "[?25l")
    if is_tty and mode == "party":
        sys.stdout.write(MOUSE_ON)
    sys.stdout.flush()

    tick = 0.5 if mode == "party" else interval
    view = View()
    data = None
    last_fetch = 0.0
    mouse_resume_at = None
    worker = None

    def start_focus(target, delay):
        nonlocal worker, mouse_resume_at
        if worker is not None and worker.is_alive():
            return
        sys.stdout.write(MOUSE_OFF)
        sys.stdout.flush()
        mouse_resume_at = time.monotonic() + delay + MOUSE_RESUME_DELAY
        worker = threading.Thread(target=focus_target, args=(target, delay), daemon=True)
        worker.start()

    def guest_by_key(key):
        if data is None:
            return None
        return next((a for a in data[0] if guest_key(a) == key), None)

    def move_selection(step):
        if not view.order:
            return
        if view.selected_key not in view.order:
            view.selected_key = view.order[0] if step > 0 else view.order[-1]
            return
        i = (view.order.index(view.selected_key) + step) % len(view.order)
        view.selected_key = view.order[i]

    def jump_attention():
        if data is None:
            return
        att = [guest_key(a) for a in attention_list(data[0], view)]
        if not att:
            return
        if view.selected_key in att:
            view.selected_key = att[(att.index(view.selected_key) + 1) % len(att)]
        else:
            view.selected_key = att[0]

    try:
        while True:
            now = time.monotonic()
            if data is None or now - last_fetch >= interval:
                fetched = fetch(kind_filter)
                if fetched is not None:
                    data = fetched
                    view.tracker.update(data[0])
                    view.names = assign_names(data[0])
                last_fetch = now
            if mouse_resume_at is not None and time.monotonic() >= mouse_resume_at:
                sys.stdout.write(MOUSE_ON)
                mouse_resume_at = None
            cols, rows_n = term_size()
            if data is None:
                lines = [f"{STATUS_COLOR['blocked']}herdr agent list に失敗しました{RESET}"]
            elif mode == "party":
                lines = render_party(data[0], data[1], view, cols, rows_n)
            else:
                lines = render_list(data[0], view, cols, int(interval), kind_filter)
            sys.stdout.write(ESC + "[H" + ESC + "[2J" + "\n".join(lines[:rows_n]))
            sys.stdout.flush()
            view.frame += 1
            if not is_tty:
                time.sleep(tick)
                continue
            # tick まで入力を待つ。表示が変わる操作があればすぐ描き直す
            deadline = time.monotonic() + tick
            redraw = False
            while not redraw:
                remain = deadline - time.monotonic()
                if remain <= 0:
                    break
                r, _, _ = select.select([fd], [], [], remain)
                if not r:
                    break
                raw = os.read(fd, 4096)
                pos, clicks, keys = parse_input(raw)
                for c in clicks:
                    target = hit_test(view.hits, c[0], c[1])
                    debug(f"click col={c[0]} row={c[1]} -> {target and target[0]}")
                    if target is not None:
                        start_focus(target, CLICK_DELAY)
                if pos is not None:
                    new_key = hover_target(view.hits, pos[0], pos[1])
                    if new_key != view.hover_key:
                        view.hover_key = new_key
                        redraw = True
                for k in keys:
                    if k in ("q", "Q"):
                        return 0
                    elif k in ("right", "down", "l", "j"):
                        move_selection(1)
                        redraw = True
                    elif k in ("left", "up", "h", "k"):
                        move_selection(-1)
                        redraw = True
                    elif k == "tab":
                        jump_attention()
                        redraw = True
                    elif k in ("enter", "o"):
                        a = guest_by_key(view.selected_key)
                        if a is not None:
                            start_focus(("guest", a), 0)
                    elif k == "esc":
                        view.selected_key = None
                        redraw = True
                    elif k == "?":
                        view.show_help = not view.show_help
                        redraw = True
            if redraw:
                view.frame -= 1  # ポーズを進めずに描き直す
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write(MOUSE_OFF + ESC + "[?25h" + RESET + "\n")
        sys.stdout.flush()
        if old_attrs is not None:
            import termios
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
    return 0


if __name__ == "__main__":
    sys.exit(main())
